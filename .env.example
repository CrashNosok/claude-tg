# Copy to .env (gitignored). Never commit real values.
TG_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to control the session
TG_ALLOWED_USER_IDS=
TMUX_SESSION=claude
TMUX_CMD=claude
# Working directory for the Claude session (used when the bot creates it)
TMUX_DIR=
# Auto-push tuning (seconds)
MIN_PUSH_SEC=3
HEARTBEAT_SEC=30
# Also push terminal screenshots when the screen settles (1/0). Full model text is always pushed.
AUTO_SCREEN=1
